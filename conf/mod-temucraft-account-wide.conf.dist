[worldserver]

########################################
# mod-temucraft-account-wide
########################################
#
#    Temucraft.AccountWide.Reputation.Enable
#        Description: Reputation progress is shared by every character of an account. Each character only gets
#                     the factions it can have (Faction.dbc: the other side's factions are never shared).
#        Default:     1

Temucraft.AccountWide.Reputation.Enable = 1

#
#    Temucraft.AccountWide.Reputation.Exclude
#        Description: Faction IDs kept per character (comma separated). By default the pairs where earning one
#                     costs the other: Aldor (932) / Scryers (934), Frenzyheart Tribe (1104) / The Oracles (1105).
#        Default:     "932,934,1104,1105"

Temucraft.AccountWide.Reputation.Exclude = "932,934,1104,1105"

#
#    Temucraft.AccountWide.Reputation.SkipAccountPrefix
#        Description: Accounts whose name starts with this don't share reputation (playerbot accounts). Empty: none
#                     are skipped.
#        Default:     "RNDBOT"

Temucraft.AccountWide.Reputation.SkipAccountPrefix = "RNDBOT"

#
#    Temucraft.AccountWide.Mounts
#    Temucraft.AccountWide.Pets
#    Temucraft.AccountWide.Recipes
#    Temucraft.AccountWide.FlightPaths
#    Temucraft.AccountWide.Titles
#        Description: What one character of an account has, every character gets when it logs in: mounts and
#                     companion pets (if its race and class may have them), recipes (if it has the profession, the
#                     skill and any specialization the recipe needs), flight paths of its faction, titles.
#        Default:     1, 1, 1, 1, 1

Temucraft.AccountWide.Mounts = 1
Temucraft.AccountWide.Pets = 1
Temucraft.AccountWide.Recipes = 1
Temucraft.AccountWide.FlightPaths = 1
Temucraft.AccountWide.Titles = 1

#
#    Temucraft.AccountWide.Mounts.NeedRiding
#    Temucraft.AccountWide.Mounts.GroundRiding
#    Temucraft.AccountWide.Mounts.FlyingRiding
#        Description: Mounts from the account only come once the character has trained riding: GroundRiding
#                     skill for ground mounts, FlyingRiding for flying ones. A character that got them earlier loses
#                     them until it trains riding, and gets them all back when it does.
#        Default:     1, 75, 225

Temucraft.AccountWide.Mounts.NeedRiding = 1
Temucraft.AccountWide.Mounts.GroundRiding = 75
Temucraft.AccountWide.Mounts.FlyingRiding = 225

#
#    Temucraft.AccountWide.LockedTrainers
#        Description: Trainers in mod_temucraft_locked_trainer stay closed until any character of the account has
#                     done their quest. GMs are never turned away.
#        Default:     1

Temucraft.AccountWide.LockedTrainers = 1

#
#    Temucraft.AccountWide.Vanity
#        Description: Vanity items (world table mod_temucraft_vanity_item, for example the Stones and Scrolls of
#                     Homecoming): one bought or found by any character is unlocked for the account, and every
#                     character that may use it can summon it again (.temucraft collection summon, or the Vanity window).
#        Default:     1

Temucraft.AccountWide.Vanity = 1

#
#    Temucraft.AccountWide.UiStore
#        Description: Keeps what the Temucraft interface saves between sessions (favourite mounts and pets of the
#                     Collections window, talent loadouts), per account or per character (addon prefix TUS).
#        Default:     1

Temucraft.AccountWide.UiStore = 1

#
#    Temucraft.AccountWide.Announce
#        Description: Says at login what came from the account's other characters.
#        Default:     1

Temucraft.AccountWide.Announce = 1

#
#    Temucraft.AccountWide.Settings.Enable
#        Description: A player's accounts share their game settings (like auto loot), key bindings and macros:
#                     when one account saves a copy, the others get the same copy, on any PC. Accounts are linked
#                     by the same e-mail (LinkByEmail) or by the player with ".temucraft shared link <account> <password>".
#                     Needs "synchronize settings" on in the client (it is by default).
#        Default:     1

Temucraft.AccountWide.Settings.Enable = 1

#
#    Temucraft.AccountWide.Settings.LinkByEmail
#        Description: Accounts with the same e-mail address share their settings without linking them first.
#        Default:     1

Temucraft.AccountWide.Settings.LinkByEmail = 1

#
#    Temucraft.AccountWide.Settings.AccountTypes
#        Description: Which account copies are shared: 0 settings (auto loot...), 2 key bindings, 4 macros.
#        Default:     "0,2,4"

Temucraft.AccountWide.Settings.AccountTypes = "0,2,4"

#
#    Temucraft.AccountWide.Settings.Characters
#    Temucraft.AccountWide.Settings.CharacterTypes
#        Description: Also share each character's own copies with all the other characters of the linked accounts:
#                     1 settings, 3 key bindings, 5 macros, 6 window layout, 7 chat windows. Off by default: many
#                     players want different action bars on different classes.
#        Default:     0, "3,5"

Temucraft.AccountWide.Settings.Characters = 0
Temucraft.AccountWide.Settings.CharacterTypes = "3,5"
